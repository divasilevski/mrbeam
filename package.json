{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && husky",
    "lint": "eslint \"**/*.{ts,vue}\"",
    "test": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "bun eslint"
    ],
    "*.{css,scss,md,json}": [
      "bun fmt --check"
    ]
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/html-validator": "^2.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.19.43",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "nuxt": "^4.6.4",
    "prettier": "^3.9.8",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vite-plugin-markdown": "^2.2.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "nanoid": "^6.0.1",
    "paper": "^0.12.18",
    "simplebar-vue": "^2.4.2"
  }
}
